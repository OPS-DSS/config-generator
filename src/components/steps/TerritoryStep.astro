<p class="eyebrow">Paso 1 de 6</p>
<h2>Territorio</h2>
<p class="intro">
  Ingrese las etiquetas territoriales que aparecerán en la configuración.
</p>

<div class="field-grid">
  <label class="field field-full">
    <span>Localidad</span>
    <input
      id="local"
      type="text"
      placeholder="Ej. San Martín del Valle o Suaza"
      required
    />
  </label>

  <label class="field">
    <span>Etiqueta subnacional</span>
    <input
      id="subnational"
      type="text"
      placeholder="Ej. Huila"
      required
    />
  </label>

  <label class="field">
    <span>Etiqueta nacional</span>
    <input
      id="national"
      type="text"
      placeholder="Ej. Colombia"
      required
    />
  </label>
</div>

<p class="error" data-territory-error hidden>
  Complete la localidad y las etiquetas subnacional y nacional.
</p>
