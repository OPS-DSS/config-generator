---
import TerritoryStep from "./steps/TerritoryStep.astro";
import FeaturesStep from "./steps/FeaturesStep.astro";
import IndicatorsStep from "./steps/IndicatorsStep.astro";
import PrioritiesStep from "./steps/PrioritiesStep.astro";
import RelationshipsStep from "./steps/RelationshipsStep.astro";
import ReviewStep from "./steps/ReviewStep.astro";
---

<section class="config-wizard" data-config-wizard>
  <nav class="steps" aria-label="Progreso">
    <button type="button" class="step is-active" data-step-nav="0">
      1. Territorio
    </button>
    <button type="button" class="step" data-step-nav="1">
      2. Funciones
    </button>
    <button type="button" class="step" data-step-nav="2">
      3. Indicadores
    </button>
    <button type="button" class="step" data-step-nav="3">
      4. Prioridades
    </button>
    <button type="button" class="step" data-step-nav="4">
      5. Relaciones
    </button>
    <button type="button" class="step" data-step-nav="5">
      6. Revisar
    </button>
  </nav>

  <form class="wizard-card" novalidate>
    <section class="wizard-step" data-step="0">
      <TerritoryStep />
    </section>

    <section class="wizard-step" data-step="1" hidden>
      <FeaturesStep />
    </section>

    <section class="wizard-step" data-step="2" hidden>
      <IndicatorsStep />
    </section>

    <section class="wizard-step" data-step="3" hidden>
      <PrioritiesStep />
    </section>

    <section class="wizard-step" data-step="4" hidden>
      <RelationshipsStep />
    </section>

    <section class="wizard-step" data-step="5" hidden>
      <ReviewStep />
    </section>

    <footer class="wizard-actions">
      <button type="button" class="secondary" data-previous disabled>
        Anterior
      </button>
      <button type="button" class="primary" data-next>
        Continuar
      </button>
    </footer>
  </form>
</section>

<script>
  import { initConfigWizard } from "../lib/wizard-controller";

  const root = document.querySelector("[data-config-wizard]");

  if (!(root instanceof HTMLElement)) {
    throw new Error("ConfigWizard no encontrado.");
  }

  initConfigWizard(root);
</script>

<style is:global>
  .config-wizard {
    width: min(100%, 1000px);
    margin: 0 auto;
  }

  .steps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .step {
    border: 0;
    border-radius: 999px;
    padding: 0.65rem 0.85rem;
    background: #eef2f7;
    color: #64748b;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
  }

  .step.is-active {
    background: #172033;
    color: #fff;
  }

  .step.is-complete {
    background: #dcfce7;
    color: #166534;
  }

  .wizard-card {
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    background: #fff;
  }

  .wizard-step {
    display: grid;
    gap: 1rem;
  }

  .wizard-step[hidden] {
    display: none;
  }

  .eyebrow {
    margin: 0;
    color: #4f46e5;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2,
  h3,
  p {
    margin-top: 0;
  }

  .intro {
    max-width: 48rem;
    color: #64748b;
    line-height: 1.6;
  }

  .field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .field-full {
    grid-column: 1 / -1;
  }

  .field {
    display: grid;
    gap: 0.4rem;
    font-weight: 700;
  }

  input[type="text"] {
    width: 100%;
    box-sizing: border-box;
    padding: 0.8rem;
    border: 1px solid #cbd5e1;
    border-radius: 0.65rem;
    font: inherit;
  }

  .option-list,
  .indicator-grid,
  .relationships {
    display: grid;
    gap: 0.85rem;
  }

  .indicator-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .option-card,
  .relation-option {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    padding: 1rem;
    border: 1px solid #dbe2ea;
    border-radius: 0.75rem;
    cursor: pointer;
  }

  .option-card:has(input:checked),
  .relation-option:has(input:checked) {
    border-color: #6366f1;
    background: #f7f7ff;
  }

  .option-card > span {
    display: grid;
    gap: 0.3rem;
  }

  small,
  .meta {
    color: #64748b;
    line-height: 1.45;
  }

  .relationship-card {
    padding: 1rem;
    border: 1px solid #dbe2ea;
    border-radius: 0.85rem;
  }

  .relationship-card h3 {
    margin-bottom: 0.35rem;
  }

  .relationship-card p {
    color: #64748b;
  }

  .relationship-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .relation-option {
    padding: 0.75rem;
  }

  .error {
    padding: 0.8rem 1rem;
    border-radius: 0.65rem;
    background: #fff1f2;
    color: #b42318;
    font-weight: 700;
  }

  .empty-message {
    padding: 1rem;
    border-radius: 0.75rem;
    background: #f8fafc;
    color: #64748b;
  }

  pre {
    max-height: 34rem;
    overflow: auto;
    padding: 1rem;
    border-radius: 0.75rem;
    background: #111827;
    color: #e5e7eb;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .wizard-actions,
  .review-actions {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .wizard-actions {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid #e2e8f0;
  }

  button.primary,
  button.secondary {
    border: 0;
    border-radius: 0.65rem;
    padding: 0.75rem 1rem;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  button.primary {
    background: #172033;
    color: #fff;
  }

  button.secondary {
    background: #eef2f7;
    color: #172033;
  }

  button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  @media (max-width: 760px) {
    .field-grid,
    .indicator-grid,
    .relationship-options {
      grid-template-columns: 1fr;
    }

    .wizard-actions,
    .review-actions {
      flex-direction: column;
    }
  }
</style>
